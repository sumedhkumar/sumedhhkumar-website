}

.tag {
  color: #D8CBA6;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.20;
  letter-spacing: 0.04em;
}

.standard-card {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.060), rgba(255, 255, 255, 0.012)),
    rgba(17, 19, 25, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 8px;
  padding: 22px;
  box-shadow: var(--shadow-card);
  transform-style: preserve-3d;
  backdrop-filter: blur(14px);
  animation: float-panel 7.5s ease-in-out infinite;
  transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}

.standard-card:nth-child(2n) {
  animation-delay: -2.6s;
}

.standard-card:nth-child(3n) {
  animation-delay: -4.2s;
}

.standard-card::before {
  position: absolute;
  top: 0;
  right: 16px;
  left: 16px;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.16), transparent);
}

.standard-card::after {
  position: absolute;
  right: 18px;
  bottom: -1px;
  left: 18px;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(184, 145, 74, 0.38), transparent);
}

.clickable-card:hover {
  background: #191C23;
  border-color: rgba(184, 145, 74, 0.44);
  box-shadow: 0 46px 94px rgba(0, 0, 0, 0.56), 0 0 0 1px rgba(184, 145, 74, 0.13), 0 24px 60px rgba(184, 145, 74, 0.065);
  transform: translateY(-9px) perspective(900px) rotateX(1deg);
}

.depth-panel {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.060), rgba(255, 255, 255, 0.014)),
    rgba(17, 19, 25, 0.92);
  box-shadow:
    0 34px 78px rgba(0, 0, 0, 0.46),
    0 18px 54px rgba(184, 145, 74, 0.050),
    inset 0 1px 0 rgba(255, 255, 255, 0.070);
  backdrop-filter: blur(18px);
  animation: float-panel 8.5s ease-in-out infinite;
}

.depth-panel::before {
  position: absolute;
  top: 0;
  right: 18px;
  left: 18px;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.depth-panel::after {
  position: absolute;
  right: 20px;
  bottom: 0;
  left: 20px;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(184, 145, 74, 0.38), transparent);
}

@keyframes float-panel {
  0%, 100% {
    translate: 0 0;
  }

  50% {
    translate: 0 -7px;
  }
}

@keyframes float-hero {
  0%, 100% {
    translate: 0 0;
  }

  50% {
    translate: 0 -10px;
  }
}

.btn {
  min-height: 48px;
  padding: 14px 20px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  color: inherit;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.20;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, color 180ms ease, transform 180ms ease;
}

.btn-primary {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.080), rgba(255, 255, 255, 0.016)),
    linear-gradient(135deg, rgba(184, 145, 74, 0.28), rgba(184, 145, 74, 0.08) 48%, rgba(216, 203, 166, 0.13));
  color: #F4ECD8;
  border-color: rgba(216, 203, 166, 0.58);
  box-shadow:
    0 20px 46px rgba(0, 0, 0, 0.34),
    0 12px 34px rgba(184, 145, 74, 0.11),
    inset 0 1px 0 rgba(255, 255, 255, 0.15),
    inset 0 -1px 0 rgba(56, 42, 25, 0.70);
}

.btn-primary:hover {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.105), rgba(255, 255, 255, 0.022)),
    linear-gradient(135deg, rgba(184, 145, 74, 0.36), rgba(184, 145, 74, 0.10) 48%, rgba(216, 203, 166, 0.17));
  border-color: rgba(216, 203, 166, 0.72);
  box-shadow:
    0 24px 54px rgba(0, 0, 0, 0.38),
    0 16px 38px rgba(184, 145, 74, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.18),
    inset 0 -1px 0 rgba(56, 42, 25, 0.74);
  transform: translateY(-2px);
}

.btn-secondary {
  background: rgba(184, 145, 74, 0.032);
  color: #D8CBA6;
  border-color: rgba(184, 145, 74, 0.48);
}

.btn-secondary:hover {
  background: rgba(184, 145, 74, 0.10);
  border-color: rgba(184, 145, 74, 0.72);
  transform: translateY(-1px);
}

.btn-disabled,
.btn:disabled {
  background: #2A2D33;
  color: #6F747C;
  border-color: rgba(255, 255, 255, 0.06);
}

.form-label {
  color: #F7F3EA;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.40;
  letter-spacing: 0.02em;
}

.form-control {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  background: #14161A;
  color: #F7F3EA;
}

.form-control::placeholder {
  color: #9CA0A7;
}

.form-control:focus {
  border-color: rgba(184, 145, 74, 0.60);
  box-shadow: 0 0 0 3px rgba(184, 145, 74, 0.12);
  outline: none;
}

.form-control:disabled {
  background: #101114;
  color: #6F747C;
}

textarea.form-control {
  min-height: 160px;
  resize: vertical;
}

.empty-state {
