@import "tailwindcss";

:root {
  --bg-primary: #050506;
  --bg-secondary: #0B0C0F;
  --bg-tertiary: #13151A;
  --surface-card: #111319;
  --surface-elevated: #191C23;
  --surface-hover: #242831;
  --accent-gold: #B8914A;
  --accent-gold-light: #D8CBA6;
  --accent-gold-dark: #5C482B;
  --accent-copper: #806247;
  --text-primary: #F7F3EA;
  --text-secondary: #CAC5B8;
  --text-muted: #9CA0A7;
  --text-disabled: #6F747C;
  --state-success: #35C486;
  --state-warning: #F59E0B;
  --state-error: #EF6F6C;
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-input: rgba(255, 255, 255, 0.12);
  --border-gold: rgba(184, 145, 74, 0.36);
  --border-gold-strong: rgba(184, 145, 74, 0.64);
  --shadow-card: 0 28px 70px rgba(0, 0, 0, 0.46), 0 18px 48px rgba(184, 145, 74, 0.035), 0 2px 0 rgba(255, 255, 255, 0.035) inset;
  --shadow-elevated: 0 56px 128px rgba(0, 0, 0, 0.64), 0 28px 90px rgba(184, 145, 74, 0.06), 0 1px 0 rgba(255, 255, 255, 0.10) inset, 0 0 0 1px rgba(184, 145, 74, 0.13);
  --radius-card: 8px;
  --radius-control: 8px;
  --radius-pill: 999px;
  --container-width: 1240px;
}

html {
  scroll-behavior: smooth;
  background: #050506;
  overflow-x: hidden;
}

body {
  position: relative;
  margin: 0;
  background:
    radial-gradient(circle at 50% 0%, rgba(184, 145, 74, 0.10), transparent 30rem),
    radial-gradient(circle at 12% 34%, rgba(255, 255, 255, 0.035), transparent 24rem),
    radial-gradient(circle at 88% 58%, rgba(184, 145, 74, 0.045), transparent 30rem),
    radial-gradient(circle at 50% 100%, rgba(255, 255, 255, 0.025), transparent 34rem),
    linear-gradient(180deg, #050506 0%, #0A0B0E 36%, #0F1115 66%, #060607 100%);
  background-attachment: fixed;
  color: #F7F3EA;
  font-family: var(--font-body), Arial, sans-serif;
  font-style: normal;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.68;
  writing-mode: horizontal-tb;
  text-orientation: mixed;
  overflow-x: hidden;
}

body::before {
  position: fixed;
  inset: 0;
  z-index: 0;
  content: "";
  pointer-events: none;
  background:
    linear-gradient(rgba(255, 255, 255, 0.020) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.016) 1px, transparent 1px);
  background-size: 92px 92px;
  opacity: 0.22;
  transform: perspective(900px) rotateX(58deg) translateY(120px) scale(1.55);
  transform-origin: 50% 100%;
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.52) 30%, transparent 86%);
  mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.52) 30%, transparent 86%);
}

body > * {
  position: relative;
  z-index: 1;
}

* {
  box-sizing: border-box;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 0;
  color: #F7F3EA;
  font-style: normal;
  writing-mode: horizontal-tb;
  text-orientation: mixed;
}

h1,
h2 {
  font-family: var(--font-display), Georgia, serif;
}

h3,
h4,
h5,
h6 {
  font-family: var(--font-body), Arial, sans-serif;
}

p {
  margin: 0;
}

a {
  color: inherit;
  text-decoration: none;
  cursor: pointer;
}

button,
input,
select,
textarea {
  font-family: var(--font-body), Arial, sans-serif;
}

button {
  cursor: pointer;
}

button:disabled,
[aria-disabled="true"] {
  cursor: not-allowed;
}

input,
textarea {
  cursor: text;
}

::selection {
  background: rgba(184, 145, 74, 0.28);
  color: #F7F3EA;
}

:focus-visible {
  outline: 2px solid #B8914A;
  outline-offset: 3px;
}

.page-shell {
  position: relative;
  background: transparent;
}

.container {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding-right: 32px;
  padding-left: 32px;
}

.section {
  position: relative;
  overflow: hidden;
  padding-top: 104px;
  padding-bottom: 104px;
}

.section::before {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  background:
    radial-gradient(circle at 82% 18%, rgba(184, 145, 74, 0.034), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.010), transparent 20%, rgba(0, 0, 0, 0.08) 100%);
}

.section::after {
  display: none;
}

.section > .container,
.section > .listing-container {
  position: relative;
  z-index: 1;
}

.section-bg-primary {
  background: transparent;
}

.section-bg-secondary {
  background: transparent;
}

.section-intro {
  max-width: 660px;
  margin-bottom: 40px;
  text-align: left;
}

.eyebrow {
  color: #B8914A;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.40;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero-title {
  font-size: 72px;
  font-weight: 700;
  line-height: 0.98;
  letter-spacing: 0;
}

.page-title {
  font-size: 60px;
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: 0;
}

.section-title {
  font-size: 44px;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: 0;
}

.subsection-title {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 0;
}

.card-title {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.30;
  letter-spacing: 0;
}

.body-large {
  color: #CAC5B8;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.72;
}

.body-standard {
  color: #CAC5B8;
