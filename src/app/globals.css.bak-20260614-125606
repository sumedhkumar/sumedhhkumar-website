}

.hero-section {
  position: relative;
  overflow: hidden;
  min-height: 820px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, transparent 24%),
    linear-gradient(146deg, #050506 0%, #101217 52%, #1B1F27 100%);
  isolation: isolate;
}

.hero-section::before {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.10), #050506 92%),
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 84px),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.028) 0 1px, transparent 1px 84px);
  transform: perspective(940px) rotateX(58deg) translateY(220px) scale(1.65);
  transform-origin: 50% 100%;
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.72) 28%, transparent 88%);
  mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.72) 28%, transparent 88%);
}

.hero-section::after {
  position: absolute;
  inset: 0;
  z-index: -1;
  content: "";
  pointer-events: none;
  background:
    linear-gradient(90deg, transparent 0%, rgba(184, 145, 74, 0.13) 48%, transparent 100%),
    linear-gradient(180deg, transparent 0%, rgba(184, 145, 74, 0.09) 52%, transparent 100%);
  opacity: 0.82;
}

.hero-grid {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  min-height: 820px;
  margin: 0 auto;
  padding: 104px 32px 88px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 44px;
}

.hero-copy {
  width: 100%;
  min-width: 0;
  display: grid;
  justify-items: center;
  gap: 16px;
  max-width: 920px;
  text-align: center;
}

.hero-copy .body-large {
  max-width: 680px;
}

.hero-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 14px;
}

.hero-pill {
  max-width: 100%;
  min-height: 34px;
  padding: 8px 14px;
  border: 1px solid rgba(184, 145, 74, 0.32);
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  background: rgba(184, 145, 74, 0.050);
  color: #D8CBA6;
  font-size: 10px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.30), 0 10px 34px rgba(184, 145, 74, 0.045), inset 0 1px 0 rgba(255, 255, 255, 0.055);
}

.hero-pill span {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: #D8C58D;
  box-shadow: 0 0 18px rgba(212, 194, 141, 0.64);
}

.hero-visual {
  position: relative;
  width: 100%;
  min-width: 0;
  max-width: 920px;
  min-height: 430px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.070), rgba(255, 255, 255, 0.018)),
    rgba(15, 17, 22, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 22px;
  padding: 18px;
  box-shadow: var(--shadow-elevated), 0 34px 90px rgba(184, 145, 74, 0.06);
  backdrop-filter: blur(24px);
  display: grid;
  gap: 16px;
  transform: perspective(1100px) rotateX(3deg) translateY(-4px);
  animation: float-hero 8s ease-in-out infinite;
}

.hero-visual::before {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(110deg, transparent 0%, rgba(212, 194, 141, 0.13) 44%, transparent 62%);
  opacity: 0;
  transition: opacity 240ms ease, transform 900ms ease;
  transform: translateX(-36%);
}

.hero-visual:hover::before {
  opacity: 1;
  transform: translateX(36%);
}

.hero-floating-note {
  position: absolute;
  z-index: 2;
  min-height: 42px;
  padding: 10px 13px;
  border: 1px solid rgba(184, 145, 74, 0.28);
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(8, 9, 11, 0.76);
  color: #D8CBA6;
  font-size: 11px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  box-shadow: 0 18px 46px rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(18px);
}

.hero-floating-note-left {
  top: 68px;
  left: -46px;
}

.hero-floating-note-right {
  right: -42px;
  bottom: 112px;
}

.hero-console-tabs {
  position: relative;
  z-index: 1;
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 999px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.035);
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.hero-console-tab {
  min-height: 38px;
  padding: 9px 13px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #9CA0A7;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  line-height: 1.2;
  text-transform: uppercase;
}

.hero-console-tab-active {
  background: rgba(184, 145, 74, 0.12);
  color: #D8CBA6;
  box-shadow: inset 0 0 0 1px rgba(184, 145, 74, 0.22), 0 12px 30px rgba(0, 0, 0, 0.24);
}

.hero-command-bar {
  position: relative;
  z-index: 1;
  min-height: 112px;
  padding: 18px;
  border: 1px solid rgba(184, 145, 74, 0.18);
  border-radius: 18px;
  display: grid;
  grid-template-columns: 1.2fr 1fr 1.1fr 64px;
  gap: 14px;
  align-items: center;
  background: rgba(5, 5, 6, 0.72);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055);
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.hero-command-field {
  min-height: 72px;
  min-width: 0;
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  display: grid;
  align-content: center;
  gap: 7px;
  background: rgba(255, 255, 255, 0.035);
}

.hero-command-field span,
.hero-chart-header span,
.hero-mini-label {
